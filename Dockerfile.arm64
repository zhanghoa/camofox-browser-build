FROM node:22-slim

ARG CAMOUFOX_VERSION=135.0.1
ARG CAMOUFOX_RELEASE=beta.24
ARG ARCH=aarch64

# 安装依赖（与官方 Dockerfile 一致）
RUN apt-get update && apt-get install -y \
    libgtk-3-0 \
    libdbus-glib-1-2 \
    libxt6 \
    libasound2 \
    libx11-xcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    libegl1-mesa \
    libgl1-mesa-dri \
    libgbm1 \
    xvfb \
    fonts-liberation \
    fonts-noto-color-emoji \
    fontconfig \
    ca-certificates \
    curl \
    unzip \
    python3-minimal \
    && rm -rf /var/lib/apt/lists/*

# 复制预下载的二进制文件（由 make fetch 生成）
COPY dist /dist

# 安装 Camoufox 浏览器（直接复制解压好的目录，避免 QEMU 下运行 unzip）
RUN mkdir -p /root/.cache/camoufox \
    && cp -r /dist/camoufox-${ARCH}/* /root/.cache/camoufox/ \
    && chmod -R 755 /root/.cache/camoufox \
    && echo "{\"version\":\"${CAMOUFOX_VERSION}\",\"release\":\"${CAMOUFOX_RELEASE}\"}" > /root/.cache/camoufox/version.json \
    && test -f /root/.cache/camoufox/camoufox-bin && echo "Camoufox installed successfully"

# 安装 yt-dlp
RUN cp /dist/yt-dlp-${ARCH} /usr/local/bin/yt-dlp && chmod +x /usr/local/bin/yt-dlp

WORKDIR /app

# 复制官方项目的其余文件
COPY package.json ./
COPY scripts/ ./scripts/
RUN npm install --production

COPY server.js ./
COPY camofox.config.json ./
COPY lib/ ./lib/
COPY plugins/ ./plugins/
COPY scripts/ ./scripts/

# 安装插件依赖（忽略可能的错误）
RUN sh scripts/install-plugin-deps.sh || true

ENV NODE_ENV=production
ENV CAMOFOX_PORT=9377
ENV PLAYWRIGHT_SKIP_BROWSER_SANDBOX=1

EXPOSE 9377

CMD ["sh", "-c", "node --max-old-space-size=${MAX_OLD_SPACE_SIZE:-128} server.js"]
