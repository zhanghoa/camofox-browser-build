# 基于官方 Dockerfile 修改，跳过 unzip，直接使用预解压的文件
FROM node:22-slim

# 保持与官方相同的构建参数
ARG CAMOUFOX_VERSION=135.0.1
ARG CAMOUFOX_RELEASE=beta.24
ARG ARCH=aarch64

# 安装所有依赖（与官方一致）
RUN apt-get update && apt-get install -y \
    libgtk-3-0 \
    libdbus-glib-1-2 \
    libxt6 \
    libasound2 \
    libx11-xcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    libegl1-mesa \
    libgl1-mesa-dri \
    libgbm1 \
    xvfb \
    fonts-liberation \
    fonts-noto-color-emoji \
    fontconfig \
    ca-certificates \
    curl \
    unzip \
    python3-minimal \
    && rm -rf /var/lib/apt/lists/*

# 关键改动：直接从构建上下文中的 dist/ 复制已解压的浏览器文件
# 注意：make fetch 已经在 dist/ 下生成了 camoufox-aarch64/ 目录（包含 camoufox-bin 等）
# 以及 yt-dlp-aarch64 文件
COPY dist /dist

# 复制浏览器到缓存目录
RUN mkdir -p /root/.cache/camoufox \
    && cp -r /dist/camoufox-${ARCH}/* /root/.cache/camoufox/ \
    && chmod -R 755 /root/.cache/camoufox \
    && echo "{\"version\":\"${CAMOUFOX_VERSION}\",\"release\":\"${CAMOUFOX_RELEASE}\"}" > /root/.cache/camoufox/version.json

# 安装 yt-dlp
RUN cp /dist/yt-dlp-${ARCH} /usr/local/bin/yt-dlp && chmod +x /usr/local/bin/yt-dlp

WORKDIR /app

# 复制官方项目的其余文件
COPY package.json ./
COPY scripts/ ./scripts/
RUN npm install --production

COPY server.js ./
COPY camofox.config.json ./
COPY lib/ ./lib/
COPY plugins/ ./plugins/
COPY scripts/ ./scripts/

# 安装插件依赖（可选，忽略错误）
RUN sh scripts/install-plugin-deps.sh || true

ENV NODE_ENV=production
ENV CAMOFOX_PORT=9377

EXPOSE 9377

CMD ["sh", "-c", "node --max-old-space-size=${MAX_OLD_SPACE_SIZE:-128} server.js"]
